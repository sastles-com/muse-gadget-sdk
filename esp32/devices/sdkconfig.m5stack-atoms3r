# M5Stack AtomS3R: ESP32-S3-PICO-1-N8R8 (8 MB flash, 8 MB octal PSRAM),
# 0.85" 128x128 LCD (GC9107 or ST7735S depending on revision, SPI3),
# front button on GPIO41, MPU6886/BMI270-class IMU and IR emitter (unused).
# No microphone and no speaker, so this is a status-screen board: it shows
# the link state, edge bars, the animation and images on the LCD.
# Load last, after sdkconfig.defaults (see README.md in this directory).
# Sources: M5GFX (m5stack/M5GFX) src/M5GFX.cpp AtomS3R autodetect block and
# Light_M5StackAtomS3R; M5Unified (m5stack/M5Unified) src/M5Unified.inl
# board table. See atoms3r.md in this directory for the full pin map.
# STATUS: the HOMEHUB_LED_BACKEND_M5STACK_ATOMS3R backend is implemented
# in main/led_status.c and builds with ESP-IDF v6.0.1
# (tools/board.sh m5stack-atoms3r build), but it has not been run on
# hardware yet.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Front (screen) button, active low. M5Unified sets GPIO41 as the AtomS3R
# button input. BOOT (GPIO0) is the internal I2C clock on this board, so
# it cannot be the setup button.
CONFIG_HOMEHUB_BUTTON_GPIO=41

# Status screen on the 128x128 LCD (backend in main/led_status.c).
CONFIG_HOMEHUB_LED_BACKEND_M5STACK_ATOMS3R=y
CONFIG_HOMEHUB_BLE_NAME_SUFFIX="-Disp"

# Phase 2: the BMI270 IMU answers sensors.read (defaults on with the
# backend; set explicitly so the overlay check covers it).
CONFIG_HOMEHUB_ATOMS3R_IMU=y

# 8 MB flash (in-package on the PICO-1). Flash mode left at the default:
# TODO verify DIO vs QIO against a factory firmware dump before building.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# Octal PSRAM holds the TLS buffers and keeps the home-network tunnel on.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_MODE_QUAD=n
CONFIG_SPIRAM_SPEED_80M=y

# The BLE controller already takes ~70 KB of internal RAM on the S3; keep the
# NimBLE host's allocations in PSRAM so pairing has room.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
